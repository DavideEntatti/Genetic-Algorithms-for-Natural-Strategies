{
  "benchmark_metadata": {
    "name": "Defaul Benchmark",
    "description": "A benchmark for testing the genetic algorithm with default settings."
  },

  "execution":{
    "ga": 1,
    "vitamin": 0,
    "mixed": 0,
    "timeout": 15,
    "directory": "MyGA/_test_cases2",
    "benchmark_output": "MyGA/_test_cases2/output/benchmark_output.csv"
  },
  
  "start_parameters": {
    "num_states": [25, 50],
    "num_agents": [5, 10],
    "num_agent_actions": [3, 6],
    "num_aps": [2, 40],
    "sparsity": [0.5, 1],
    "coalition_size": [1, 2],
    "k": [1,3],
    "set_size": [3,6]
  },

  "execution_plan": {
    "iterations_per_config": 1,
    "num_configs": 20,
    "final_values":
    {
        "fin_num_states": 200,
        "fin_num_agents": 5,
        "fin_num_agent_actions": 5,
        "fin_num_aps": 10,
        "fin_sparsity": 0.5,
        "fin_coalition_size": 2,
        "fin_k": 2,
        "fin_set_size": 4
    }
  },

  "template_parameters":{
    "templates":["G", "F", "X", "U"],
    "template_repetitions": 4
  }

}