{
  "benchmark_metadata": {
    "name": "Defaul Benchmark",
    "description": "A benchmark for testing the genetic algorithm with default settings."
  },

  "execution":{
    "ga": 1,
    "vitamin": 1,
    "timeout": 5,
    "directory": "MyGA/_test_cases",
    "benchmark_output": "MyGA/_test_cases/output/benchmark_output_prova.csv"
  },
  
  "start_parameters": {
    "num_states": 200,
    "num_agents": 2,
    "num_agent_actions": 2,
    "num_aps": 50,
    "sparsity": 0.5,
    "coalition_size": 5,
    "k": 4,
    "set_size": 4
  },

  "execution_plan": {
    "iterations_per_config": 1,
    "num_configs": 1,
    "final_values":
    {
        "fin_num_states": 100,
        "fin_num_agents": 2,
        "fin_num_agent_actions": 2,
        "fin_num_aps": 50,
        "fin_sparsity": 0.5,
        "fin_coalition_size": 5,
        "fin_k": 4,
        "fin_set_size": 4
    }
  },

  "plot":{
    "plot_output": "MyGA/_test_cases/output/benchmark_plot.png",
    "plot_key": "configuration"
  }

}