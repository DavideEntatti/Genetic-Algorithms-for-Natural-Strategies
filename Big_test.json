{
  "benchmark_metadata": {
    "name": "Defaul Benchmark",
    "description": "A benchmark for testing the genetic algorithm with default settings."
  },

  "execution":{
    "ga": 1,
    "vitamin": 0,
    "mixed": 0,
    "timeout": 1,
    "directory": "MyGA/_test_cases",
    "benchmark_output": "MyGA/_test_cases/output/benchmark_output.csv"
  },
  
  "start_parameters": {
    "num_states": 100,
    "num_agents": 5,
    "num_agent_actions": 5,
    "num_aps": 25,
    "sparsity": 0.5,
    "coalition_size": 2,
    "k": 4,
    "set_size": 3
  },

  "execution_plan": {
    "iterations_per_config": 10,
    "num_configs": 10,
    "final_values":
    {
        "fin_num_states": 200,
        "fin_num_agents": 10,
        "fin_num_agent_actions": 10,
        "fin_num_aps": 50,
        "fin_sparsity": 0.5,
        "fin_coalition_size": 4,
        "fin_k": 8,
        "fin_set_size": 5
    }
  },

  "template_parameters":{
    "templates":["G", "F", "X", "U"],
    "template_repetitions": 5
  }

}