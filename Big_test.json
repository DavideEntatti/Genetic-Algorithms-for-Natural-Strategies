{
  "benchmark_metadata": {
    "name": "Defaul Benchmark",
    "description": "A benchmark for testing the genetic algorithm with default settings."
  },

  "execution":{
    "ga": 1,
    "vitamin": 1,
    "timeout": 5,
    "directory": "MyGA/_test_cases",
    "benchmark_output": "MyGA/_test_cases/output/benchmark_output_prova.csv"
  },
  
  "start_parameters": {
    "num_states": [10, 20],
    "num_agents": 4,
    "num_agent_actions": 4,
    "num_aps": 10,
    "sparsity": 0.5,
    "coalition_size": 2,
    "k": 2,
    "set_size": 4
  },

  "execution_plan": {
    "iterations_per_config": 1,
    "num_configs": 1,
    "final_values":
    {
        "fin_num_states": 200,
        "fin_num_agents": 5,
        "fin_num_agent_actions": 5,
        "fin_num_aps": 10,
        "fin_sparsity": 0.5,
        "fin_coalition_size": 2,
        "fin_k": 2,
        "fin_set_size": 4
    }
  },

  "template_parameters":{
    "templates":["G", "F", "X", "U"],
    "template_repetitions": 1
  }

}